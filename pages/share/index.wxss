/* pages/share/index.wxss */
.container {
  min-height: 100vh;
  background-color: #FFF0E5;
  padding: 20rpx;
  padding-bottom: 40rpx;
  padding-top: 20rpx;
}

/* Canvas 预览区域 */
.canvas-wrapper {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 壁纸模式：移除 padding 和背景，确保 Canvas 渲染为完整的 750rpx 宽度 */
.wallpaper-mode-wrapper {
  padding: 0 !important; /* 移除 padding 以允许 750rpx 完整宽度 */
  background-color: transparent !important; /* 与容器背景融合 */
  box-shadow: none !important; /* 移除阴影样式，壁纸预览更干净 */
  border-radius: 0 !important; /* 移除圆角 */
  margin-bottom: 24rpx; /* 保留底部间距 */
}

/* 确保 canvas 容器在壁纸模式下允许完整宽度 */
.wallpaper-mode-wrapper .canvas-container {
  width: 100%;
  padding: 0; /* 移除容器内边距 */
}

/* === 1. 画布容器 (紧凑版) === */
.canvas-container {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  /* 减少上下间距，把内容往上提 */
  padding: 10rpx 0; 
  /* 移除不必要的 min-height，避免强制撑开 */
  min-height: auto;
  /* 确保容器本身不带色 */
  background-color: transparent;
  /* 关键：设置为相对定位，使 overlay 的 absolute 定位相对于此容器 */
  position: relative;
}

.preview-canvas {
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15);
  border-radius: 16rpx;
  /* 移除 transition，避免与 JS 尺寸计算冲突 */
  transition: none;
  display: block;
  background-color: #FFFFFF;
  max-width: 100%;
  height: auto;
}

/* 壁纸模式下可拖拽的容器 */
.draggable-container {
  user-select: none; /* 禁止选择文本 */
  position: relative;
  /* 不设置 touch-action: none，允许页面正常滚动 */
}

/* 壁纸模式下可拖拽的 Canvas */
.draggable-canvas {
  user-select: none; /* 禁止选择文本 */
  /* 不设置 touch-action: none，允许页面正常滚动 */
}

/* 二维码浮动层（Floating Widget） */
.qr-widget-overlay {
  position: absolute;
  /* 确保高 z-index 以在顶层并接收触摸事件 */
  z-index: 999;
  
  /* 匹配 Canvas 设计 */
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF0E5 100%);
  border-radius: 40rpx; /* 约 20px */
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
  
  /* Flex 布局 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  /* 内容内边距 */
  padding: 20rpx;
  box-sizing: border-box;
  
  /* 确保可见和可交互 */
  opacity: 1;
  pointer-events: auto;
  transition: none; /* 移除过渡以实现即时拖拽 */
}

/* 内容容器 */
.widget-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* 二维码图片 - 超瘦身版 */
.widget-qr {
  /* 从 220rpx 缩小到 200rpx，匹配 JS 新逻辑 */
  width: 200rpx;
  height: 200rpx;
  margin-top: 0;
}

/* 文字组 */
.widget-text-group {
  /* 匹配 JS 中的 gap: 16 */
  margin-top: 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  /* 间距 6rpx，Canvas 绘图时将严格对其 */
  gap: 6rpx;
  width: 100%;
  padding: 0 4rpx;
}

/* 文字样式 */
.widget-text-title,
.widget-text-desc {
  /* FIX: Reduce font size to fit within the slimmer widget width */
  /* 浮层二维码文字使用固定大小，不随长辈模式变化 */
  font-size: 22rpx !important;
  font-weight: bold;
  color: #000;
  line-height: 1.4;
  white-space: nowrap; /* 防止文字换行 */
  overflow: hidden;
  text-overflow: ellipsis;
}

/* === 2. 模式切换按钮组 (轻量化卡片风格) === */
.tab-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 30rpx;
  background-color: transparent !important;
  margin-top: 20rpx; 
  margin-bottom: 20rpx;
  gap: 20rpx; /* 按钮之间的间距 */
}

.tab-item {
  display: flex;
  /* 垂直排列：图标在上，文字在下 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 轻量化卡片样式 */
  background-color: #F7F8FA; /* 极淡灰色背景 */
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  min-width: 160rpx; /* 确保三个按钮大小基本一致 */
  transition: all 0.2s;
  /* 去除边框，用背景色区分 */
  border: none;
}

.tab-item:active {
  /* 按下反馈 */
  opacity: 0.8;
  transform: scale(0.98);
}

.tab-item.active {
  /* 选中状态：橙色背景 */
  background-color: #FF9C00;
  /* 可选：淡橙色阴影 */
  box-shadow: 0 4rpx 12rpx rgba(255, 156, 0, 0.3);
}

.tab-icon {
  width: var(--icon-size-sm);
  height: var(--icon-size-sm);
  font-size: var(--icon-size-sm);
  line-height: 1;
  margin-bottom: 8rpx; /* 图标和文字之间的间距 */
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: var(--font-base);
  color: #333;
  font-weight: 400;
  line-height: var(--line-height);
  transition: all 0.2s;
}

/* 选中状态：文字变白色 */
.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: 500;
}

/* 选中状态：图标处理（针对 Emoji，可以通过 filter 稍微调整） */
.tab-item.active .tab-icon {
  /* Emoji 本身无法直接改色，但可以通过 filter 微调亮度 */
  filter: brightness(1.2);
}

/* === 3. 底部操作区 (确保紧凑) === */
.action-area {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 30rpx; /* 留一点底边距即可 */
}

/* 打印版操作区 */
.safety-tip {
  background-color: #FFF5E6;
  border-left: 4rpx solid #FF6B00;
  padding: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.tip-text {
  font-size: var(--font-base);
  color: var(--text-sub);
  line-height: var(--line-height);
}

/* 壁纸版操作区 */
.bg-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.bg-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  border: 2rpx solid #E0E0E0;
}

.bg-option-icon {
  font-size: var(--icon-size-sm);
  margin-bottom: 12rpx;
}

.bg-option-text {
  font-size: var(--font-base);
  color: var(--text-main);
}

/* 默认背景列表 */
.default-bg-list {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.default-bg-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(33.33% - 14rpx);
}

.bg-thumbnail {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.default-bg-item.selected .bg-thumbnail {
  border-color: #FF6B00;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.bg-name {
  font-size: var(--font-base);
  color: var(--text-sub);
  text-align: center;
}

.default-bg-item.selected .bg-name {
  color: #FF6B00;
  font-weight: 600;
}

/* Footer Action Bar */
.footer-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}

/* 保存按钮 */
.save-btn {
  height: var(--btn-height);
  border-radius: 48rpx;
  font-size: var(--font-lg);
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  box-sizing: border-box;
}

/* 确保主按钮占据全部可用空间 */
.save-btn.main-btn {
  width: 100%;
  flex: 1;
}

.save-btn::after {
  border: none;
}

.main-btn {
  flex: 1;
}

.print-btn {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C00 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.3);
}

/* NFC 按钮 */
.side-btn {
  width: 96rpx;
  height: 96rpx;
  background: #FFF7E6;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FF8C00;
  border: 2rpx solid #FF8C00;
  box-sizing: border-box;
  transition: opacity 0.2s;
}

.side-btn:active {
  opacity: 0.7;
  background: #FFE4BA;
}

.nfc-icon {
  font-size: var(--icon-size-sm);
  margin-bottom: 4rpx;
}

.nfc-text {
  font-size: var(--font-base);
  font-weight: bold;
}

.wallpaper-btn {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, 0.3);
}

.recommended-btn {
  background: linear-gradient(135deg, #FF6B00 0%, #FF8C00 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.3);
}