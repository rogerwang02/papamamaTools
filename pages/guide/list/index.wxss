/* pages/guide/list/index.wxss */
.container {
  padding: 30rpx;
  background-color: #F7F8FA;
  min-height: 100vh;
}

.header-area {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: var(--font-xl);
  font-weight: bold;
  color: var(--text-main);
  display: block;
}

.page-desc {
  font-size: var(--font-base);
  color: var(--text-light);
  margin-top: 10rpx;
  display: block;
  line-height: var(--line-height);
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.guide-card {
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-left {
  flex: 1;
  padding-right: 20rpx;
}

.card-title {
  font-size: var(--font-lg);
  font-weight: bold;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}

.card-intro {
  font-size: var(--font-base);
  color: var(--text-sub);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: var(--line-height);
}

.card-icon {
  font-size: calc(var(--icon-size) * 0.75);
}

